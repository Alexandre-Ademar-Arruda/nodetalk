
<style>
    header h1, header h2, header h4, section, section h1, section h3 {display: flex;flex-direction: column;margin-bottom: 20px;margin-top: 0; }
</style>
<link rel="stylesheet" href="/stylesheet/contatos.css">
<% include ../partials/header %>
<header>
    <h1>Node talk</h1>
    <h2>Ola <%= usuario?usuario.nome:"Visitante" %>!</h2>
    <h4>Seja Bem-vindo!</h4>
</header>
<section>
    <h1>Bem vindo a pagina contatos</h1>
    <% if(usuario && usuario.email) { %>
        <h3>Seu email é: <%= usuario.email.toUpperCase() %>!</h3>
    <% } %>
    <div>
        <section>
            <h1>Lista de Contatos Disponíveis</h1>
            <% if(usuario && usuario.email) { %>
                <h3>Logado como: <%= usuario.nome || usuario.email %></h3>
            <% } %>

            <div style="margin-top: 20px;">
                <% if(typeof contatos !== "undefined" && contatos.length > 0) { %>
                    <table border="1" cellpadding="10" cellspacing="0" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th style="text-align: left;">Apelido / Nome</th>
                                <th style="text-align: center; width: 150px;">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% contatos.forEach(function(contato) { %>
                                <!-- Evita que o usuário clique para conversar consigo mesmo -->
                                <% if(contato.email !== usuario.email) { %>
                                    <tr>
                                        <td><strong><%= contato.nome %></strong> (<%= contato.email %>)</td>
                                        <td style="text-align: center;">
                                            <!-- O botão redireciona para a rota que cria/entra na sala privada -->
                                            <a href="/chat/<%= contato.email %>" style="text-decoration: none; background-color: #007bff; color: white; padding: 6px 12px; border-radius: 4px;">Conversar</a>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }) %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p>Nenhum outro contato cadastrado no momento.</p>
                <% } %>
            </div>

            <p style="margin-top: 20px;"><a href="/">Voltar para Home</a></p>
        </section>
        <% if(typeof contatos!== "undefined" && contatos.length > 0) { %>
            <ul class="contatos-grid">
                <% contatos.forEach(function(contato, index) { %>
                    <li class="contato-item">
                        <div class="contato-info">
                            <strong><%= contato.nome %></strong>
                            <span>(<%= contato.email %>)</span>
                        </div>
                        <div class="contato-acoes">
                            <a href="/contatos/<%= index %>/edit">editar</a>
                            <a href="/chat/<%= contato.email %>">Conversar</a>
                            <form action="/contatos/<%= index %>/remover" method="POST" style="display:inline;">
                                <button type="submit">Remover</button>
                            </form>
                        </div>
                    </li>
                <% }) %>
            </ul>    
        <% } else{ %>
            <p>Nenhum contato cadastrado ainda.</p>
        <% } %>
    </div>

<button type="button" onclick="toggleFormulario()" >Inserir Contato</button>    
    <p>Voltar para home <a href="/">Home page</a></p>
    <% include ../partials/formInserir %>
</section>
<% include ../partials/footer %>