<% include ../header %>
<script src="/socket.io/socket.io.js"></script> 
<script>
    var socket=io.connect()
    socket.on("send-client",function(msg){
        document.getElementById("chat").innerHTML+=msg
    })
    var enviar=function(){
        var nome=document.getElementById("nome").value
        var msg=document.getElementById("msg").value
        var fileInput=document.getElementById("arquivo")
        if(fileInput.files.length>0){
            var file=fileInput.files[0]
            var reader=new FileReader()

            reader.onload=function(e){
                socket.emit("send-server",{
                    nome:nome,
                    msg:msg,
                    arquivo:{
                        nome:file.name,
                        tipo:file.type,
                        dados:e.target.result
                    }
                })
                fileInput.value=""
            }
            reader.readAsArrayBuffer(file)
        }else{
            socket.emit("send-server",{nome:nome,msg:msg})
        }
        document.getElementById("msg").value=""
    }
</script>
<header>
    <h2>Ntalk- Chat</h2>
</header>
<section class="chat-section">
    <pre id="chat"></pre>
    <input type="hidden" id="nome" value="<%- usuario.nome %>">
    <input type="text" id="msg" placeholder="Mensagem">
    <input type="file" id="arquivo" accept="video/*,image/*">
    <button onclick="enviar();">Enviar</button>
</section>
<% include ../exit %>
<% include ../footer %>